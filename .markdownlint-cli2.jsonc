{
  // Prose-friendly Markdown lint for SPARK docs. Structural rules stay on;
  // line length, compact tables, and inline HTML (SPDX comments) are allowed.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    ".git",
    "hardware/outputs",
    "bom/bom_readable.md",
    "bom/sourcing_notes.md"
  ]
}
